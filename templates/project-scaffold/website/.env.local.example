# Copy to .env.local and fill in. Never commit .env.local itself.
#
# This file is the authoritative list — CI checks that every process.env.*
# the app reads appears here. If you add a new env var to the code, add it here
# in the same commit.

# ── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. Both values are public by design and are sent to
# the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Site URL ────────────────────────────────────────────────────────────────
# The public origin: auth email redirects and SEO metadata. In production this
# is your real domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
